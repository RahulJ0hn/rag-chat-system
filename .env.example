# OpenAI
OPENAI_API_KEY=sk-...

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
# Only required for a hosted cluster (e.g. Qdrant Cloud) — leave blank
# for a local/self-hosted instance with no auth, like docker-compose.
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Embedding + LLM
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Cache
CACHE_TTL=3600
CACHE_SIMILARITY_THRESHOLD=0.92

# AWS S3
AWS_ACCESS_KEY_ID=AKIAEXAMPLE
AWS_SECRET_ACCESS_KEY=changeme
AWS_REGION=ap-south-1
S3_BUCKET_NAME=rahul-rag-chat-documents
S3_PRESIGN_EXPIRY=3600

# Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Evals
RUN_EVALS=true
EVAL_ASYNC=true

# Reranker (Feature: Cohere Reranker implemented)
COHERE_API_KEY=...
RERANKER_MODEL=rerank-english-v3.0
RERANKER_TOP_N=5

# Hybrid Search (Feature: Hybrid Search (Dense + Sparse BM25) implemented)
USE_HYBRID_SEARCH=true

# Conversation Memory (Feature: Conversation Memory (Multi-turn Chat) implemented)
CONVERSATION_MEMORY_TTL=1800
CONVERSATION_MAX_TURNS=6
